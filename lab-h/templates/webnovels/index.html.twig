{% extends 'base.html.twig' %}

{% block title %}Webnovels index{% endblock %}

{% block body %}
    <h1>Webnovels index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Tytul</th>
                <th>Autor</th>
                <th>Opis</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for webnovel in webnovels %}
            <tr>
                <td>{{ webnovel.id }}</td>
                <td>{{ webnovel.tytul }}</td>
                <td>{{ webnovel.autor }}</td>
                <td>{{ webnovel.opis }}</td>
                <td>
                    <a href="{{ path('app_webnovels_show', {'id': webnovel.id}) }}">show</a>
                    <a href="{{ path('app_webnovels_edit', {'id': webnovel.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_webnovels_new') }}">Create new</a>
{% endblock %}
