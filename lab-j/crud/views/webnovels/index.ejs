<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/assets/src/vendor/reset.css' />
    <link rel='stylesheet' href='/assets/dist/style.min.css' />
  </head>
  <body>
    <main>
    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/webnovels">Webnovels</a></li>
      </ul>
    </nav>

    <h1>Webnovels List</h1>
    <a href="/webnovels/create">Create new</a>
    <ul class="index-list">
      <% webnovels.forEach(function(item){ %>
        <li>
          <h3><%= item.Tytul %></h3>
          <p><strong>Author:</strong> <%= item.Autor %></p>
          <ul class="action-list">
            <li><a href="/webnovels/<%= item.id %>">Details</a></li>
            <li><a href="/webnovels/<%= item.id %>/edit">Edit</a></li>
            <li><a href="/webnovels/<%= item.id %>/delete">Delete</a></li>
          </ul>
        </li>
      <% }) %>
    </ul>
    </main>
  </body>
</html>
